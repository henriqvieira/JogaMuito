{
  "name": "jogamuito",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start:metro": "react-native start --reset-cache",
    "android:debug": "react-native run-android",
    "test": "jest",
    "detox:build": "detox build --configuration android.emu.debug",
    "detox:test": "detox test --configuration android.emu.debug --cleanup",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:test:android": "detox test --configuration android.emu.debug --cleanup",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:test:ios": "detox test --configuration ios.sim.debug --cleanup",
    "detox:test:auth": "detox test --configuration android.emu.debug --cleanup e2e/auth.e2e.ts",
    "detox:test:events": "detox test --configuration android.emu.debug --cleanup e2e/events.e2e.ts",
    "detox:test:finance": "detox test --configuration android.emu.debug --cleanup e2e/finance.e2e.ts",
    "detox:test:reports": "detox test --configuration android.emu.debug --cleanup e2e/reports.e2e.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "firebase": "^12.17.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-share": "^12.3.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/detox": "^17.14.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "detox": "^20.51.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
