{
  "name": "JogaMuito",
  "displayName": "JogaMuito",
  "version": "1.0.0",
  "description": "A React Native application for football and sports community experiences.",
  "slug": "joga-muito",
  "privacy": "public",
  "sdkVersion": "41.0.0",
  "platforms": ["ios", "android"],
  "icon": "./assets/icon.png",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#ffffff"
  },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": ["**/*"],
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#FFFFFF"
    }
  },
  "web": {
    "favicon": "./assets/favicon.png"
  }
}
